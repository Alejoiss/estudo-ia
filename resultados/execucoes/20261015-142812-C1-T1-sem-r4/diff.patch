diff --git a/vetclinic/services/vacinas.py b/vetclinic/services/vacinas.py
new file mode 100644
index 0000000..6fc7c3f
--- /dev/null
+++ b/vetclinic/services/vacinas.py
@@ -0,0 +1,89 @@
+"""Regras de negócio de vacinas."""
+
+import sqlite3
+from datetime import timedelta
+
+from vetclinic.config import DATE_FORMAT
+from vetclinic.errors import InvalidDataError, ResourceNotFoundError
+from vetclinic.repositories import Row
+from vetclinic.repositories import vacinas as vaccine_repository
+from vetclinic.schemas.vacinas import VaccineInput
+from vetclinic.services.pets import get_pet_or_raise
+from vetclinic.services.veterinarios import get_veterinarian_or_raise
+from vetclinic.validation import parse_date_text
+
+VACCINE_NOT_FOUND_MESSAGE = "Vacina não encontrada"
+BOOSTER_DATE_OUT_OF_RANGE_MESSAGE = "O intervalo de reforço resulta em uma data inválida"
+
+
+def get_vaccine_or_raise(connection: sqlite3.Connection, vaccine_id: int) -> Row:
+    """Devolve a vacina ou levanta `ResourceNotFoundError`."""
+    vaccine = vaccine_repository.find_vaccine_by_id(connection, vaccine_id)
+    if vaccine is None:
+        raise ResourceNotFoundError(VACCINE_NOT_FOUND_MESSAGE)
+    return vaccine
+
+
+def _calculate_booster_date(data: VaccineInput) -> str:
+    """Data de aplicação somada ao intervalo; 422 se ultrapassar o limite de datas."""
+    try:
+        booster_date = parse_date_text(data.data_aplicacao) + timedelta(
+            days=data.intervalo_reforco_dias
+        )
+    except OverflowError:
+        raise InvalidDataError(BOOSTER_DATE_OUT_OF_RANGE_MESSAGE) from None
+    return booster_date.strftime(DATE_FORMAT)
+
+
+def _require_references(connection: sqlite3.Connection, data: VaccineInput) -> None:
+    get_pet_or_raise(connection, data.pet_id)
+    get_veterinarian_or_raise(connection, data.veterinario_id)
+
+
+def create_vaccine(connection: sqlite3.Connection, data: VaccineInput) -> Row:
+    """Registra uma vacina para um pet e um veterinário existentes."""
+    _require_references(connection, data)
+    vaccine_id = vaccine_repository.insert_vaccine(
+        connection,
+        data.pet_id,
+        data.veterinario_id,
+        data.nome_vacina,
+        data.data_aplicacao,
+        data.intervalo_reforco_dias,
+        _calculate_booster_date(data),
+    )
+    return get_vaccine_or_raise(connection, vaccine_id)
+
+
+def replace_vaccine(connection: sqlite3.Connection, vaccine_id: int, data: VaccineInput) -> Row:
+    """Substitui os dados de uma vacina, recalculando a data de reforço."""
+    get_vaccine_or_raise(connection, vaccine_id)
+    _require_references(connection, data)
+    vaccine_repository.update_vaccine(
+        connection,
+        vaccine_id,
+        data.pet_id,
+        data.veterinario_id,
+        data.nome_vacina,
+        data.data_aplicacao,
+        data.intervalo_reforco_dias,
+        _calculate_booster_date(data),
+    )
+    return get_vaccine_or_raise(connection, vaccine_id)
+
+
+def delete_vaccine(connection: sqlite3.Connection, vaccine_id: int) -> None:
+    """Exclui uma vacina."""
+    get_vaccine_or_raise(connection, vaccine_id)
+    vaccine_repository.delete_vaccine(connection, vaccine_id)
+
+
+def list_vaccines_of_pet(connection: sqlite3.Connection, pet_id: int) -> list[Row]:
+    """Lista as vacinas de um pet existente."""
+    get_pet_or_raise(connection, pet_id)
+    return vaccine_repository.list_vaccines_of_pet(connection, pet_id)
+
+
+def list_pending_boosters(connection: sqlite3.Connection, until: str) -> list[Row]:
+    """Lista as vacinas cujo reforço vence até a data informada."""
+    return vaccine_repository.list_vaccines_with_booster_until(connection, until)
