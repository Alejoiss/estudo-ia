diff --git a/vacinas.py b/vacinas.py
new file mode 100644
index 0000000..5427b0e
--- /dev/null
+++ b/vacinas.py
@@ -0,0 +1,102 @@
+from datetime import date, timedelta
+
+from fastapi import APIRouter, Response
+from pydantic import BaseModel, field_validator, model_validator
+
+from comum import InteiroPositivo, Texto, ou_404
+from db import db, inserir, todos, um
+import pets
+import veterinarios
+
+router = APIRouter(tags=["vacinas"])
+
+# data_reforco não é coluna: calculada na leitura.
+SELECT = "SELECT *, date(data_aplicacao, '+' || intervalo_reforco_dias || ' days') AS data_reforco FROM vacinas"
+
+
+class VacinaIn(BaseModel):
+    pet_id: InteiroPositivo
+    veterinario_id: InteiroPositivo
+    nome_vacina: Texto
+    data_aplicacao: date
+    intervalo_reforco_dias: InteiroPositivo
+
+    @field_validator("data_aplicacao")
+    @classmethod
+    def _nao_futura(cls, v):
+        if v > date.today():
+            raise ValueError("data_aplicacao não pode ser futura")
+        return v
+
+    @model_validator(mode="after")
+    def _reforco_valido(self):
+        try:
+            self.data_aplicacao + timedelta(days=self.intervalo_reforco_dias)
+        except OverflowError:
+            raise ValueError("intervalo_reforco_dias muito grande")
+        return self
+
+
+def buscar(c, id):
+    return ou_404(um(c, SELECT + " WHERE id=?", id), "vacina")
+
+
+def valores(body: VacinaIn):
+    return body.pet_id, body.veterinario_id, body.nome_vacina, body.data_aplicacao.isoformat(), body.intervalo_reforco_dias
+
+
+@router.post("/vacinas", status_code=201)
+def criar(body: VacinaIn):
+    with db() as c:
+        pets.buscar(c, body.pet_id)
+        veterinarios.buscar(c, body.veterinario_id)
+        id = inserir(
+            c,
+            "INSERT INTO vacinas(pet_id,veterinario_id,nome_vacina,data_aplicacao,intervalo_reforco_dias) VALUES(?,?,?,?,?)",
+            *valores(body),
+        )
+        return buscar(c, id)
+
+
+@router.get("/vacinas/reforcos-pendentes")
+def reforcos_pendentes(ate: date):
+    with db() as c:
+        return todos(
+            c,
+            f"SELECT * FROM ({SELECT}) WHERE data_reforco <= ? ORDER BY data_reforco, id",
+            ate.isoformat(),
+        )
+
+
+@router.get("/vacinas/{id}")
+def obter(id: int):
+    with db() as c:
+        return buscar(c, id)
+
+
+@router.put("/vacinas/{id}")
+def atualizar(id: int, body: VacinaIn):
+    with db() as c:
+        buscar(c, id)
+        pets.buscar(c, body.pet_id)
+        veterinarios.buscar(c, body.veterinario_id)
+        c.execute(
+            "UPDATE vacinas SET pet_id=?,veterinario_id=?,nome_vacina=?,data_aplicacao=?,intervalo_reforco_dias=? WHERE id=?",
+            (*valores(body), id),
+        )
+        return buscar(c, id)
+
+
+@router.delete("/vacinas/{id}", status_code=204)
+def remover(id: int):
+    with db() as c:
+        buscar(c, id)
+        c.execute("DELETE FROM vacinas WHERE id=?", (id,))
+    return Response(status_code=204)
+
+
+@router.get("/pets/{pet_id}/vacinas")
+def vacinas_do_pet(pet_id: int):
+    with db() as c:
+        pets.buscar(c, pet_id)
+        return todos(c, SELECT + " WHERE pet_id=? ORDER BY data_aplicacao DESC, id", pet_id)
