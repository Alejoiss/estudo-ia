+"""Schemas do plano de fidelidade."""
+
+from typing import Literal
+
+from pydantic import BaseModel
+
+LoyaltyPlan = Literal["nenhum", "prata", "ouro"]
+
+
+class LoyaltyPlanInput(BaseModel):
+    """Corpo de definição do plano de fidelidade de um tutor."""
+
+    plano: LoyaltyPlan
+
+
+class LoyaltyPlanOutput(LoyaltyPlanInput):
+    """Plano de fidelidade retornado pela API."""
+
+    tutor_id: int
