+"""Testes do plano de fidelidade (caixa-preta, só HTTP)."""
+import os
+import uuid
+from datetime import datetime, timedelta
+
+import httpx
+import pytest
+
+BASE_URL = os.environ.get("BASE_URL", "http://127.0.0.1:8765")
+
+
+@pytest.fixture(scope="module")
+def api():
+    with httpx.Client(base_url=BASE_URL, timeout=10) as client:
+        yield client
+
+
+def _tutor(api):
+    body = {"nome": "Maria", "email": f"m{uuid.uuid4().hex[:6]}@ex.com"}
+    return api.post("/tutores", json=body).json()["id"]
+
+
+def _atender(api, tutor_id, produtos=()):
+    pet = api.post("/pets", json={"nome": "Rex", "especie": "cao", "tutor_id": tutor_id}).json()
+    vet = api.post("/veterinarios", json={"nome": "Ana", "crmv": uuid.uuid4().hex[:8]}).json()
+    dia = datetime.now() + timedelta(days=30)
+    dia += timedelta(days=(7 - dia.weekday()) % 7)  # próxima segunda-feira
+    inicio = dia.strftime("%Y-%m-%dT10:00")
+    ag = api.post(
+        "/agendamentos", json={"pet_id": pet["id"], "veterinario_id": vet["id"], "inicio": inicio}
+    ).json()
+    resp = api.post(f"/agendamentos/{ag['id']}/atendimento", json={"anotacoes": "ok", "produtos": list(produtos)})
+    assert resp.status_code == 201
+    return api.get(f"/faturas/{resp.json()['fatura_id']}").json()
+
+
+def test_plano_padrao_e_troca(api):
+    tutor_id = _tutor(api)
+    assert api.get(f"/tutores/{tutor_id}/plano").json() == {"tutor_id": tutor_id, "plano": "nenhum"}
+    resp = api.put(f"/tutores/{tutor_id}/plano", json={"plano": "ouro"})
+    assert resp.status_code == 200
+    assert resp.json() == {"tutor_id": tutor_id, "plano": "ouro"}
+    assert "plano" not in api.get(f"/tutores/{tutor_id}").json()
+
+
+def test_plano_erros(api):
+    tutor_id = _tutor(api)
+    assert api.get("/tutores/999999/plano").status_code == 404
+    assert api.put("/tutores/999999/plano", json={"plano": "ouro"}).status_code == 404
+    assert api.put(f"/tutores/{tutor_id}/plano", json={"plano": "diamante"}).status_code == 422
+
+
+@pytest.mark.parametrize("plano,desconto", [("nenhum", 0), ("prata", 1500), ("ouro", 3000)])
+def test_desconto_na_fatura(api, plano, desconto):
+    tutor_id = _tutor(api)
+    api.put(f"/tutores/{tutor_id}/plano", json={"plano": plano})
+    fatura = _atender(api, tutor_id)
+    assert fatura["desconto_centavos"] == desconto
+    assert fatura["itens"][0]["total_centavos"] == 15000
+    assert fatura["total_centavos"] == 15000 - desconto
+
+
+def test_desconto_nao_muda_depois(api):
+    tutor_id = _tutor(api)
+    api.put(f"/tutores/{tutor_id}/plano", json={"plano": "prata"})
+    fatura = _atender(api, tutor_id)
+    api.put(f"/tutores/{tutor_id}/plano", json={"plano": "ouro"})
+    resp = api.post(
+        f"/faturas/{fatura['id']}/itens",
+        json={"descricao": "Extra", "quantidade": 2, "valor_unitario_centavos": 1000},
+    ).json()
+    assert resp["desconto_centavos"] == 1500
+    assert resp["total_centavos"] == 15000 + 2000 - 1500
+    listada = api.get(f"/tutores/{tutor_id}/faturas").json()[0]
+    assert listada["desconto_centavos"] == 1500
+
+
+def test_excluir_tutor_com_plano(api):
+    tutor_id = _tutor(api)
+    api.put(f"/tutores/{tutor_id}/plano", json={"plano": "prata"})
+    assert api.delete(f"/tutores/{tutor_id}").status_code == 204
