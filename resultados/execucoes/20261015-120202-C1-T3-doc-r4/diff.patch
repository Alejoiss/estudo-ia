+
+
+def find_loyalty_plan(connection: sqlite3.Connection, tutor_id: int) -> str | None:
+    """Devolve o plano gravado do tutor, ou `None` se nunca foi definido."""
+    row = connection.execute(
+        "SELECT plano FROM tutor_planos WHERE tutor_id = ?", (tutor_id,)
+    ).fetchone()
+    return None if row is None else str(row["plano"])
+
+
+def upsert_loyalty_plan(connection: sqlite3.Connection, tutor_id: int, plan: str) -> None:
+    """Define o plano de fidelidade de um tutor."""
+    connection.execute(
+        "INSERT INTO tutor_planos (tutor_id, plano) VALUES (?, ?) "
+        "ON CONFLICT(tutor_id) DO UPDATE SET plano = excluded.plano",
+        (tutor_id, plan),
+    )
