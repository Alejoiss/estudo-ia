diff --git a/vacinas.py b/vacinas.py
new file mode 100644
index 0000000..50ccaa7
--- /dev/null
+++ b/vacinas.py
@@ -0,0 +1,80 @@
+from datetime import date, timedelta
+
+from fastapi import APIRouter, Response
+from pydantic import BaseModel, field_validator
+
+from comum import Inteiro, InteiroPositivo, Texto, erro, ou_404
+from db import db, inserir, todos, um
+import pets
+import veterinarios
+
+router = APIRouter(prefix="/vacinas", tags=["vacinas"])
+
+
+class VacinaIn(BaseModel):
+    pet_id: Inteiro
+    veterinario_id: Inteiro
+    nome_vacina: Texto
+    data_aplicacao: date
+    intervalo_reforco_dias: InteiroPositivo
+
+    @field_validator("data_aplicacao")
+    @classmethod
+    def _nao_futura(cls, v):
+        if v > date.today():
+            raise ValueError("data_aplicacao não pode ser futura")
+        return v
+
+
+def buscar(c, id):
+    return ou_404(um(c, "SELECT * FROM vacinas WHERE id=?", id), "vacina")
+
+
+def valores(body: VacinaIn):
+    try:
+        reforco = body.data_aplicacao + timedelta(days=body.intervalo_reforco_dias)
+    except OverflowError:
+        erro(422, "intervalo_reforco_dias fora da faixa")
+    return (body.pet_id, body.veterinario_id, body.nome_vacina, body.data_aplicacao.isoformat(),
+            body.intervalo_reforco_dias, reforco.isoformat())
+
+
+@router.post("", status_code=201)
+def criar(body: VacinaIn):
+    with db() as c:
+        pets.buscar(c, body.pet_id)
+        veterinarios.buscar(c, body.veterinario_id)
+        id = inserir(c, "INSERT INTO vacinas(pet_id,veterinario_id,nome_vacina,data_aplicacao,"
+                        "intervalo_reforco_dias,data_reforco) VALUES(?,?,?,?,?,?)", *valores(body))
+        return buscar(c, id)
+
+
+@router.get("/reforcos-pendentes")
+def reforcos_pendentes(ate: date):
+    with db() as c:
+        return todos(c, "SELECT * FROM vacinas WHERE data_reforco<=? ORDER BY data_reforco, id", ate.isoformat())
+
+
+@router.get("/{id}")
+def obter(id: int):
+    with db() as c:
+        return buscar(c, id)
+
+
+@router.put("/{id}")
+def atualizar(id: int, body: VacinaIn):
+    with db() as c:
+        buscar(c, id)
+        pets.buscar(c, body.pet_id)
+        veterinarios.buscar(c, body.veterinario_id)
+        c.execute("UPDATE vacinas SET pet_id=?,veterinario_id=?,nome_vacina=?,data_aplicacao=?,"
+                  "intervalo_reforco_dias=?,data_reforco=? WHERE id=?", (*valores(body), id))
+        return buscar(c, id)
+
+
+@router.delete("/{id}", status_code=204)
+def remover(id: int):
+    with db() as c:
+        buscar(c, id)
+        c.execute("DELETE FROM vacinas WHERE id=?", (id,))
+    return Response(status_code=204)
