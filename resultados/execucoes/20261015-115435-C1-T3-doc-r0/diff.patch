+"""Plano de fidelidade dos tutores e desconto na fatura. Fala com a API só via HTTP."""
+import os
+import uuid
+from datetime import date, timedelta
+
+import httpx
+import pytest
+
+BASE_URL = os.environ["BASE_URL"]
+
+
+@pytest.fixture(scope="module")
+def api():
+    with httpx.Client(base_url=BASE_URL, timeout=10) as client:
+        yield client
+
+
+def _atender(api, tutor_id, dia_offset):
+    """Agenda numa terça distante e registra o atendimento; devolve a fatura."""
+    dia = date.today() + timedelta(days=400 + dia_offset)
+    dia += timedelta(days=(1 - dia.weekday()) % 7)
+    pet = api.post("/pets", json={"nome": "Rex", "especie": "cao", "tutor_id": tutor_id}).json()
+    vet = api.post("/veterinarios", json={"nome": "Ana", "crmv": f"PR-{uuid.uuid4().hex[:8]}"}).json()
+    ag = api.post(
+        "/agendamentos",
+        json={"pet_id": pet["id"], "veterinario_id": vet["id"], "inicio": f"{dia}T10:00"},
+    ).json()
+    prod = api.post(
+        "/produtos", json={"nome": "Vermífugo", "preco_centavos": 2500, "estoque": 10, "estoque_minimo": 1}
+    ).json()
+    atendimento = api.post(
+        f"/agendamentos/{ag['id']}/atendimento",
+        json={"anotacoes": "ok", "produtos": [{"produto_id": prod["id"], "quantidade": 2}]},
+    )
+    assert atendimento.status_code == 201
+    return api.get(f"/faturas/{atendimento.json()['fatura_id']}").json()
+
+
+def _tutor(api):
+    return api.post("/tutores", json={"nome": "Maria", "email": f"m{uuid.uuid4().hex[:6]}@ex.com"}).json()
+
+
+def test_plano_padrao_e_alteracao(api):
+    tutor = _tutor(api)
+    assert "plano" not in tutor
+    assert api.get(f"/tutores/{tutor['id']}/plano").json() == {"tutor_id": tutor["id"], "plano": "nenhum"}
+    resposta = api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "ouro"})
+    assert resposta.json() == {"tutor_id": tutor["id"], "plano": "ouro"}
+    assert api.get(f"/tutores/{tutor['id']}/plano").json()["plano"] == "ouro"
+
+
+def test_plano_erros(api):
+    tutor = _tutor(api)
+    assert api.get("/tutores/999999/plano").status_code == 404
+    assert api.put("/tutores/999999/plano", json={"plano": "ouro"}).status_code == 404
+    assert api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "diamante"}).status_code == 422
+
+
+@pytest.mark.parametrize(
+    "plano,desconto", [("nenhum", 0), ("prata", 1500), ("ouro", 3000)]
+)
+def test_desconto_na_fatura(api, plano, desconto):
+    tutor = _tutor(api)
+    api.put(f"/tutores/{tutor['id']}/plano", json={"plano": plano})
+    fatura = _atender(api, tutor["id"], ["nenhum", "prata", "ouro"].index(plano))
+    assert fatura["desconto_centavos"] == desconto
+    assert fatura["itens"][0]["total_centavos"] == 15000
+    assert fatura["total_centavos"] == 20000 - desconto
+
+
+def test_desconto_congelado_e_itens_extras_sem_desconto(api):
+    tutor = _tutor(api)
+    api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "prata"})
+    fatura = _atender(api, tutor["id"], 10)
+    api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "ouro"})
+    extra = api.post(
+        f"/faturas/{fatura['id']}/itens",
+        json={"descricao": "Banho", "quantidade": 1, "valor_unitario_centavos": 5000},
+    ).json()
+    assert extra["desconto_centavos"] == 1500
+    assert extra["total_centavos"] == 20000 + 5000 - 1500
