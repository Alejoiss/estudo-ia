+++ b/vetclinic/repositories/vacinas.py
@@ -0,0 +1,84 @@
+"""Persistência de vacinas."""
+
+import sqlite3
+
+from vetclinic.repositories import Row, row_to_dict
+
+
+def insert_vaccine(
+    connection: sqlite3.Connection,
+    pet_id: int,
+    veterinario_id: int,
+    nome_vacina: str,
+    data_aplicacao: str,
+    intervalo_reforco_dias: int,
+    data_reforco: str,
+) -> int:
+    """Insere uma vacina e devolve o id gerado."""
+    cursor = connection.execute(
+        "INSERT INTO vacinas (pet_id, veterinario_id, nome_vacina, data_aplicacao,"
+        " intervalo_reforco_dias, data_reforco) VALUES (?, ?, ?, ?, ?, ?)",
+        (pet_id, veterinario_id, nome_vacina, data_aplicacao, intervalo_reforco_dias, data_reforco),
+    )
+    return int(cursor.lastrowid)
+
+
+def find_vaccine_by_id(connection: sqlite3.Connection, vaccine_id: int) -> Row | None:
+    """Busca uma vacina pelo id."""
+    return row_to_dict(
+        connection.execute("SELECT * FROM vacinas WHERE id = ?", (vaccine_id,)).fetchone()
+    )
+
+
+def list_vaccines_of_pet(connection: sqlite3.Connection, pet_id: int) -> list[Row]:
+    """Lista as vacinas de um pet por data de aplicação decrescente e id crescente."""
+    rows = connection.execute(
+        "SELECT * FROM vacinas WHERE pet_id = ? ORDER BY data_aplicacao DESC, id", (pet_id,)
+    )
+    return [dict(row) for row in rows]
+
+
+def list_vaccines_with_booster_until(connection: sqlite3.Connection, until: str) -> list[Row]:
+    """Lista as vacinas com reforço até a data (inclusive) por data de reforço e id crescentes."""
+    rows = connection.execute(
+        "SELECT * FROM vacinas WHERE data_reforco <= ? ORDER BY data_reforco, id", (until,)
+    )
+    return [dict(row) for row in rows]
+
+
+def count_vaccines_of_pet(connection: sqlite3.Connection, pet_id: int) -> int:
+    """Conta as vacinas de um pet."""
+    return connection.execute(
+        "SELECT COUNT(*) FROM vacinas WHERE pet_id = ?", (pet_id,)
+    ).fetchone()[0]
+
+
+def update_vaccine(
+    connection: sqlite3.Connection,
+    vaccine_id: int,
+    pet_id: int,
+    veterinario_id: int,
+    nome_vacina: str,
+    data_aplicacao: str,
+    intervalo_reforco_dias: int,
+    data_reforco: str,
+) -> None:
+    """Substitui os dados de uma vacina."""
+    connection.execute(
+        "UPDATE vacinas SET pet_id = ?, veterinario_id = ?, nome_vacina = ?, data_aplicacao = ?,"
+        " intervalo_reforco_dias = ?, data_reforco = ? WHERE id = ?",
+        (
+            pet_id,
+            veterinario_id,
+            nome_vacina,
+            data_aplicacao,
+            intervalo_reforco_dias,
+            data_reforco,
+            vaccine_id,
+        ),
+    )
+
+
+def delete_vaccine(connection: sqlite3.Connection, vaccine_id: int) -> None:
+    """Remove uma vacina."""
+    connection.execute("DELETE FROM vacinas WHERE id = ?", (vaccine_id,))
