+"""Rotas de vacinas."""
+
+from fastapi import APIRouter, Response, status
+
+from vetclinic.routers import ConnectionDependency
+from vetclinic.schemas.vacinas import VaccineInput, VaccineOutput
+from vetclinic.services import vacinas as vaccine_service
+from vetclinic.validation import DateText
+
+router = APIRouter(prefix="/vacinas", tags=["vacinas"])
+
+
+@router.post("", response_model=VaccineOutput, status_code=status.HTTP_201_CREATED)
+def create_vaccine(data: VaccineInput, connection: ConnectionDependency):
+    """Registra uma vacina aplicada."""
+    return vaccine_service.create_vaccine(connection, data)
+
+
+# Declarada antes de `/{vaccine_id}` para que "reforcos-pendentes" não seja lido como id.
+@router.get("/reforcos-pendentes", response_model=list[VaccineOutput])
+def list_pending_boosters(ate: DateText, connection: ConnectionDependency):
+    """Lista as vacinas com reforço até a data informada."""
+    return vaccine_service.list_pending_boosters(connection, ate)
+
+
+@router.get("/{vaccine_id}", response_model=VaccineOutput)
+def get_vaccine(vaccine_id: int, connection: ConnectionDependency):
+    """Consulta uma vacina."""
+    return vaccine_service.get_vaccine_or_raise(connection, vaccine_id)
+
+
+@router.put("/{vaccine_id}", response_model=VaccineOutput)
+def replace_vaccine(vaccine_id: int, data: VaccineInput, connection: ConnectionDependency):
+    """Substitui os dados de uma vacina."""
+    return vaccine_service.replace_vaccine(connection, vaccine_id, data)
+
+
+@router.delete("/{vaccine_id}", status_code=status.HTTP_204_NO_CONTENT)
+def delete_vaccine(vaccine_id: int, connection: ConnectionDependency) -> Response:
+    """Exclui uma vacina."""
+    vaccine_service.delete_vaccine(connection, vaccine_id)
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
