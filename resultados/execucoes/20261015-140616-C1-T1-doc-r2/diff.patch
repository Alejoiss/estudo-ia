@@ -0,0 +1,118 @@
+"""Testes de vacinas. Falam com a API só via HTTP."""
+import os
+import uuid
+
+import httpx
+import pytest
+
+BASE_URL = os.environ["BASE_URL"]
+
+
+@pytest.fixture(scope="module")
+def api():
+    with httpx.Client(base_url=BASE_URL, timeout=10) as client:
+        yield client
+
+
+@pytest.fixture
+def pet(api):
+    tutor = api.post("/tutores", json={"nome": "Maria", "email": f"m{uuid.uuid4().hex[:6]}@ex.com"}).json()
+    return api.post("/pets", json={"nome": "Rex", "especie": "cao", "tutor_id": tutor["id"]}).json()
+
+
+@pytest.fixture
+def vet(api):
+    return api.post("/veterinarios", json={"nome": "Ana", "crmv": f"PR-{uuid.uuid4().hex[:8]}"}).json()
+
+
+def corpo(pet, vet, **extra):
+    body = {
+        "pet_id": pet["id"],
+        "veterinario_id": vet["id"],
+        "nome_vacina": "V10",
+        "data_aplicacao": "2024-01-31",
+        "intervalo_reforco_dias": 30,
+    }
+    body.update(extra)
+    return body
+
+
+def test_criar_calcula_reforco(api, pet, vet):
+    resp = api.post("/vacinas", json=corpo(pet, vet))
+    assert resp.status_code == 201
+    assert resp.json()["data_reforco"] == "2024-03-01"
+    assert api.get(f"/vacinas/{resp.json()['id']}").json() == resp.json()
+
+
+def test_cliente_nao_envia_data_reforco(api, pet, vet):
+    resp = api.post("/vacinas", json=corpo(pet, vet, data_reforco="2030-01-01"))
+    assert resp.status_code == 201
+    assert resp.json()["data_reforco"] == "2024-03-01"
+
+
+def test_substituir_recalcula_reforco(api, pet, vet):
+    vid = api.post("/vacinas", json=corpo(pet, vet)).json()["id"]
+    resp = api.put(f"/vacinas/{vid}", json=corpo(pet, vet, intervalo_reforco_dias=365))
+    assert resp.status_code == 200
+    assert resp.json()["data_reforco"] == "2025-01-30"
+
+
+@pytest.mark.parametrize(
+    "extra",
+    [
+        {"nome_vacina": "  "},
+        {"data_aplicacao": "2999-01-01"},
+        {"data_aplicacao": "2024-1-1"},
+        {"intervalo_reforco_dias": 0},
+        {"intervalo_reforco_dias": 10.5},
+    ],
+)
+def test_dados_invalidos(api, pet, vet, extra):
+    assert api.post("/vacinas", json=corpo(pet, vet, **extra)).status_code == 422
+
+
+def test_inexistentes_404(api, pet, vet):
+    assert api.post("/vacinas", json=corpo({"id": 10**9}, vet)).status_code == 404
+    assert api.post("/vacinas", json=corpo(pet, {"id": 10**9})).status_code == 404
+    assert api.get("/vacinas/999999999").status_code == 404
+    assert api.put("/vacinas/999999999", json=corpo(pet, vet)).status_code == 404
+    assert api.delete("/vacinas/999999999").status_code == 404
+    assert api.get("/pets/999999999/vacinas").status_code == 404
+
+
+def test_excluir(api, pet, vet):
+    vid = api.post("/vacinas", json=corpo(pet, vet)).json()["id"]
+    assert api.delete(f"/vacinas/{vid}").status_code == 204
+    assert api.get(f"/vacinas/{vid}").status_code == 404
+
+
+def test_listar_por_pet_ordem(api, pet, vet):
+    a = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2024-01-01")).json()["id"]
+    b = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2024-05-01")).json()["id"]
+    c = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2024-01-01")).json()["id"]
+    ids = [v["id"] for v in api.get(f"/pets/{pet['id']}/vacinas").json()]
+    assert ids == [b, a, c]
+
+
+def test_reforcos_pendentes(api, pet, vet):
+    d = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2001-03-01", intervalo_reforco_dias=10)).json()
+    e = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2001-01-01", intervalo_reforco_dias=10)).json()
+    f = api.post("/vacinas", json=corpo(pet, vet, data_aplicacao="2001-01-01", intervalo_reforco_dias=10)).json()
+    resp = api.get("/vacinas/reforcos-pendentes", params={"ate": "2001-03-11"})
+    assert resp.status_code == 200
+    ids = [v["id"] for v in resp.json() if v["id"] in (d["id"], e["id"], f["id"])]
+    assert ids == [e["id"], f["id"], d["id"]]
+    resp = api.get("/vacinas/reforcos-pendentes", params={"ate": "2001-03-10"})
+    assert d["id"] not in [v["id"] for v in resp.json()]
+
+
+def test_reforcos_pendentes_exige_ate_valido(api):
+    assert api.get("/vacinas/reforcos-pendentes").status_code == 422
+    assert api.get("/vacinas/reforcos-pendentes", params={"ate": "2024-13-01"}).status_code == 422
+
+
+def test_pet_com_vacina_nao_exclui(api, pet, vet):
+    vid = api.post("/vacinas", json=corpo(pet, vet)).json()["id"]
+    assert api.delete(f"/pets/{pet['id']}").status_code == 409
+    api.delete(f"/vacinas/{vid}")
+    assert api.delete(f"/pets/{pet['id']}").status_code == 204
