+"""Schemas de vacinas."""
+
+from pydantic import BaseModel
+
+from vetclinic.validation import (
+    NonBlankText,
+    PastOrPresentDateText,
+    PositiveInteger,
+    StrictInteger,
+)
+
+
+class VaccineInput(BaseModel):
+    """Corpo de criação e de substituição de uma vacina."""
+
+    pet_id: StrictInteger
+    veterinario_id: StrictInteger
+    nome_vacina: NonBlankText
+    data_aplicacao: PastOrPresentDateText
+    intervalo_reforco_dias: PositiveInteger
+
+
+class VaccineOutput(VaccineInput):
+    """Vacina retornada pela API, com a data de reforço calculada."""
+
+    id: int
+    data_reforco: str
