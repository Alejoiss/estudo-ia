+def find_loyalty_plan_of_tutor(connection: sqlite3.Connection, tutor_id: int) -> str | None:
+    """Devolve o plano de fidelidade gravado para o tutor, se houver."""
+    row = connection.execute(
+        "SELECT plano FROM tutor_planos WHERE tutor_id = ?", (tutor_id,)
+    ).fetchone()
+    return None if row is None else str(row["plano"])
