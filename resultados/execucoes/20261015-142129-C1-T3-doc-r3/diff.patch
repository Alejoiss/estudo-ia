+"""Plano de fidelidade do tutor e desconto na consulta (somente via HTTP)."""
+import os
+import uuid
+
+import httpx
+import pytest
+
+BASE_URL = os.environ.get("BASE_URL", "http://127.0.0.1:8765")
+
+
+@pytest.fixture(scope="module")
+def api():
+    with httpx.Client(base_url=BASE_URL, timeout=10) as client:
+        yield client
+
+
+def _atender(api, plano, inicio):
+    tutor = api.post("/tutores", json={"nome": "Ana", "email": "ana@ex.com"}).json()
+    if plano:
+        assert api.put(f"/tutores/{tutor['id']}/plano", json={"plano": plano}).status_code == 200
+    pet = api.post("/pets", json={"nome": "Rex", "especie": "cao", "tutor_id": tutor["id"]}).json()
+    vet = api.post("/veterinarios", json={"nome": "Dra", "crmv": f"PR-{uuid.uuid4().hex[:8]}"}).json()
+    produto = api.post(
+        "/produtos", json={"nome": "Ração", "preco_centavos": 1000, "estoque": 5, "estoque_minimo": 1}
+    ).json()
+    agendamento = api.post(
+        "/agendamentos", json={"pet_id": pet["id"], "veterinario_id": vet["id"], "inicio": inicio}
+    ).json()
+    atendimento = api.post(
+        f"/agendamentos/{agendamento['id']}/atendimento",
+        json={"anotacoes": "ok", "produtos": [{"produto_id": produto["id"], "quantidade": 2}]},
+    )
+    assert atendimento.status_code == 201
+    return tutor, api.get(f"/faturas/{atendimento.json()['fatura_id']}").json()
+
+
+def test_plano_padrao_e_validacoes(api):
+    tutor = api.post("/tutores", json={"nome": "Ana", "email": "ana@ex.com"}).json()
+    assert "plano" not in tutor
+    assert api.get(f"/tutores/{tutor['id']}/plano").json() == {"tutor_id": tutor["id"], "plano": "nenhum"}
+    assert api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "bronze"}).status_code == 422
+    assert api.get("/tutores/999999/plano").status_code == 404
+    assert api.put("/tutores/999999/plano", json={"plano": "ouro"}).status_code == 404
+
+
+@pytest.mark.parametrize("plano,desconto", [(None, 0), ("prata", 1500), ("ouro", 3000)])
+def test_desconto_na_consulta(api, plano, desconto):
+    _, fatura = _atender(api, plano, "2030-01-08T10:00")
+    assert fatura["desconto_centavos"] == desconto
+    assert fatura["itens"][0]["total_centavos"] == 15000
+    assert fatura["total_centavos"] == 15000 + 2000 - desconto
+
+
+def test_mudar_plano_e_novos_itens_nao_alteram_fatura(api):
+    tutor, fatura = _atender(api, "ouro", "2030-01-08T11:00")
+    api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "nenhum"})
+    api.post(f"/faturas/{fatura['id']}/itens", json={"descricao": "X", "quantidade": 1, "valor_unitario_centavos": 500})
+    atual = api.get(f"/faturas/{fatura['id']}").json()
+    assert atual["desconto_centavos"] == 3000
+    assert atual["total_centavos"] == 15000 + 2000 + 500 - 3000
