+def vacina_data(body):
+    get("pets", body.pet_id)
+    get("veterinarios", body.veterinario_id)
+    try:
+        reforco = date.fromisoformat(body.data_aplicacao) + timedelta(days=body.intervalo_reforco_dias)
+    except OverflowError:
+        err(422, "data_reforco fora do intervalo")
+    return {**body.model_dump(), "data_reforco": reforco.isoformat()}
