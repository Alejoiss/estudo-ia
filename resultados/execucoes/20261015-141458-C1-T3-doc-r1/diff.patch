@@ -0,0 +1,84 @@
+"""Testes do plano de fidelidade dos tutores. Falam com a API só por HTTP."""
+import os
+import uuid
+from datetime import datetime, timedelta
+
+import httpx
+import pytest
+
+BASE_URL = os.environ.get("BASE_URL", "http://127.0.0.1:8000")
+
+
+@pytest.fixture(scope="module")
+def api():
+    with httpx.Client(base_url=BASE_URL, timeout=10) as client:
+        yield client
+
+
+def _criar(api, rota, corpo):
+    resposta = api.post(rota, json=corpo)
+    assert resposta.status_code == 201, resposta.text
+    return resposta.json()
+
+
+def _segunda_as_10h(semanas_a_frente: int) -> str:
+    hoje = datetime.now()
+    segunda = hoje + timedelta(days=(7 - hoje.weekday()) % 7 or 7, weeks=semanas_a_frente)
+    return segunda.strftime("%Y-%m-%dT10:00")
+
+
+def _atender(api, plano, inicio, produtos=()):
+    tutor = _criar(api, "/tutores", {"nome": "Ana", "email": f"a{uuid.uuid4().hex[:6]}@ex.com"})
+    assert api.put(f"/tutores/{tutor['id']}/plano", json={"plano": plano}).status_code == 200
+    pet = _criar(api, "/pets", {"nome": "Rex", "especie": "cao", "tutor_id": tutor["id"]})
+    vet = _criar(api, "/veterinarios", {"nome": "Dr", "crmv": f"PR-{uuid.uuid4().hex[:8]}"})
+    agendamento = _criar(
+        api, "/agendamentos", {"pet_id": pet["id"], "veterinario_id": vet["id"], "inicio": inicio}
+    )
+    atendimento = _criar(
+        api, f"/agendamentos/{agendamento['id']}/atendimento", {"anotacoes": "", "produtos": list(produtos)}
+    )
+    return tutor, api.get(f"/faturas/{atendimento['fatura_id']}").json()
+
+
+def test_plano_padrao_e_alteracao(api):
+    tutor = _criar(api, "/tutores", {"nome": "Ana", "email": "a@ex.com"})
+    assert "plano" not in tutor
+    assert api.get(f"/tutores/{tutor['id']}/plano").json() == {"tutor_id": tutor["id"], "plano": "nenhum"}
+    resposta = api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "ouro"})
+    assert resposta.json() == {"tutor_id": tutor["id"], "plano": "ouro"}
+    assert api.get(f"/tutores/{tutor['id']}/plano").json()["plano"] == "ouro"
+
+
+def test_plano_erros(api):
+    tutor = _criar(api, "/tutores", {"nome": "Ana", "email": "a@ex.com"})
+    assert api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "diamante"}).status_code == 422
+    assert api.get("/tutores/999999/plano").status_code == 404
+    assert api.put("/tutores/999999/plano", json={"plano": "prata"}).status_code == 404
+
+
+@pytest.mark.parametrize(
+    ("plano", "desconto"), [("nenhum", 0), ("prata", 1500), ("ouro", 3000)]
+)
+def test_desconto_na_consulta(api, plano, desconto):
+    produto = _criar(
+        api, "/produtos", {"nome": "Ração", "preco_centavos": 2500, "estoque": 5, "estoque_minimo": 1}
+    )
+    _, fatura = _atender(
+        api, plano, _segunda_as_10h(10 + len(plano)), [{"produto_id": produto["id"], "quantidade": 2}]
+    )
+    assert fatura["desconto_centavos"] == desconto
+    assert [item["total_centavos"] for item in fatura["itens"]] == [15000, 5000]
+    assert fatura["total_centavos"] == 20000 - desconto
+
+
+def test_desconto_nao_muda_com_plano_nem_com_novos_itens(api):
+    tutor, fatura = _atender(api, "prata", _segunda_as_10h(30))
+    api.put(f"/tutores/{tutor['id']}/plano", json={"plano": "ouro"})
+    assert api.get(f"/faturas/{fatura['id']}").json()["desconto_centavos"] == 1500
+    atualizada = api.post(
+        f"/faturas/{fatura['id']}/itens",
+        json={"descricao": "Extra", "quantidade": 1, "valor_unitario_centavos": 1000},
+    ).json()
+    assert atualizada["desconto_centavos"] == 1500
+    assert atualizada["total_centavos"] == 15000 + 1000 - 1500
